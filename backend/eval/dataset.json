      "expected_pages": [1]
    },
    {
      "id": "solartrack-method",
      "papers": ["solartrack"],
      "question": "What technique does SolarTrack use to smooth noisy sensor readings?",
      "expected_keyword_groups": [["kalman filter", "kalman"]],
      "expected_pages": [2]
    },
    {
      "id": "solartrack-trial-details",
      "papers": ["solartrack"],
      "question": "How many rooftop installations were used in SolarTrack's field trials, and over what time period?",
      "expected_keyword_groups": [["4", "four"], ["three months", "three-month", "3 months"]],
      "expected_pages": [2]
    },
    {
      "id": "solartrack-unknown",
      "papers": ["solartrack"],
      "question": "What operating system does SolarTrack's control software run on?",
      "expect_unknown": true
    },
    {
      "id": "packlite-headline-number",
      "papers": ["packlite"],
      "question": "How much does PackLite reduce checkpoint storage by?",
      "expected_keyword_groups": [["60%", "sixty percent", "60 percent"]],
      "expected_pages": [1]
    },
    {
      "id": "packlite-method",
      "papers": ["packlite"],
      "question": "What encoding technique does PackLite use to compress checkpoints?",
