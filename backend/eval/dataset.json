      "expected_pages": [2]
    },
    {
      "id": "packlite-trial-details",
      "papers": ["packlite"],
      "question": "How many training runs were used to evaluate PackLite, and what was the absolute storage reduction?",
      "expected_keyword_groups": [["5", "five"], ["840", "2.1"]],
      "expected_pages": [2]
    },
    {
      "id": "packlite-unknown",
      "papers": ["packlite"],
      "question": "What programming language is PackLite implemented in?",
      "expect_unknown": true
    },
    {
      "id": "cross-paper-comparison",
      "papers": ["solartrack", "packlite"],
      "question": "What percentage improvement does each of these two papers report, and for what?",
      "expected_keyword_groups": [["28%", "twenty eight"], ["60%", "sixty"]],
      "expect_both_papers_cited": true
    }
