DATABASE_URL=postgresql+psycopg://app_user:app_password@localhost:5432/app_db
CORS_ORIGINS=http://localhost:5173
APP_NAME=Full-Stack Starter API
API_PREFIX=/api/v1
JWT_SECRET_KEY=change-me-in-development-use-a-long-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_PATH=storage/faiss/index.faiss
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
LLM_REQUEST_TIMEOUT_SECONDS=300
NOTIFICATION_CHECK_INTERVAL_HOURS=4
NOTIFICATION_CANDIDATE_LIMIT=20
NOTIFICATION_SCORE_THRESHOLD=0.35
# Optional: Semantic Scholar API key (free) — https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=
